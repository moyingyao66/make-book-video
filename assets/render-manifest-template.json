    },
    "audience-close": {
      "type": "image",
      "path": "visuals/audience-close.png",
      "fit": "cover",
      "motion": "slow-zoom",
      "sourceProvider": "gpt-image",
      "intent": "回到观众处境并收束为克制、可带走的结论。",
      "assetStatus": "pending-semantic-review"
