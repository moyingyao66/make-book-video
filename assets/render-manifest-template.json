      "intent": "固定开场完整结束后再进入封面轮播。",
      "assetStatus": "pending-search-frame-review-and-attribution"
    },
    "anticipation-carousel": {
      "type": "carousel",
      "items": [],
      "itemFrames": 9,
      "maxWidth": 820,
      "maxHeight": 1320,
      "framePadding": 42,
      "backgroundColor": "#F3EEE4",
      "intent": "五本不同真实封面形成期待，手机端能捕捉完整书名。",
      "assetStatus": "pending-phone-readability-review"
    },
    "book-reveal": {
