  "audio": {
    "narration": "timing/narration.timestamped.final.wav",
    "narrationVolume": 1.0,
    "bgm": {
      "path": "",
      "volume": 0.035,
      "fadeInSeconds": 1.0,
      "fadeOutSeconds": 3.0
    },
    "sfx": []
  },
  "captions": {
    "ass": "timing/subtitles.ass",
    "burnIn": true,
    "mode": "bilingual",
    "requireEnglish": true,
    "font": "PingFang SC",
    "fontSize": 72,
    "englishFontSize": 40,
    "positionY": 1500,
    "safeBottomPx": 360
