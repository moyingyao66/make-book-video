      "intent": "具体呈现目标观众的问题处境及后果。",
      "assetStatus": "pending-semantic-review"
    },
    "alternative-explanation": {
      "type": "image",
      "path": "visuals/alternative-explanation.png",
      "fit": "cover",
      "motion": "slow-zoom",
