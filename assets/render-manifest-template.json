      "assetStatus": "pending-semantic-review"
    },
    "concrete-example": {
      "type": "image",
      "path": "visuals/concrete-example.png",
      "fit": "cover",
      "motion": "slow-zoom",
      "sourceProvider": "gpt-image",
      "intent": "把服务主线的生活案例画成可理解的动作和结果。",
      "assetStatus": "pending-semantic-review"
    },
    "practical-boundary": {
      "type": "image",
      "path": "visuals/practical-boundary.png",
      "fit": "cover",
      "motion": "slow-zoom",
